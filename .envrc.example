# Copy to .envrc for local development. Do not commit real .envrc files.

# Provider API keys are optional when MOCK_PROVIDERS=true.
# Use non-secret placeholders in this example file; put real keys only in .envrc or your secret manager.
export OPENAI_API_KEY="your-openai-api-key"
export ANTHROPIC_API_KEY="your-anthropic-api-key"
export GEMINI_API_KEY="your-gemini-api-key"

# Security: replace every value below before running outside disposable local dev.
export JWT_SECRET="replace-with-32-plus-byte-random-hex"
export GOVERNANCE_INTERNAL_TOKEN="replace-with-32-plus-byte-random-hex"
export GATEWAY_BOOTSTRAP_TOKEN="replace-with-32-plus-byte-random-hex"
export PSEUDONYM_HMAC_KEY="replace-with-32-plus-byte-random-hex"

# Services: Docker Compose maps Postgres to localhost:15433 and the proxy to localhost:18765.
export DATABASE_URL="postgresql://gateway:gateway@localhost:15433/gateway"
export REDIS_URL="redis://localhost:6379"
export OPA_URL="http://localhost:8181"
export GOVERNANCE_URL="http://localhost:8000"
export GATEWAY_BASE_URL="http://localhost:18765"
export MODELS_YAML="config/models.yaml"

# MCP Reverse Proxy (non-default host port). Its OPA Sidecar has no host
# port: it shares the proxy container's network namespace and is reachable
# only over loopback from that paired replica.
export GATEWAY_MCPPROXY_PORT="18766"

# PII detection model.
# Local high-recall option: en_core_web_lg (~680MB)
# Smaller deploy-friendly option: en_core_web_sm (~12MB)
export SPACY_MODEL="en_core_web_lg"

# PII backend: local fallback is Presidio; use Google in deployed environments
# after enabling dlp.googleapis.com and configuring workload identity/ADC.
export PII_BACKEND="presidio"
export GOOGLE_CLOUD_PROJECT=""
export GOOGLE_DLP_LOCATION="global"
# Optional regional endpoint hostname when data must stay in-region in transit.
export GOOGLE_DLP_API_ENDPOINT=""
export GOOGLE_DLP_EXPECTED_SERVICE_ACCOUNT=""
export GOOGLE_DLP_MIN_LIKELIHOOD="POSSIBLE"
export GOOGLE_DLP_TIMEOUT_SECONDS="5"
export GOOGLE_DLP_INFO_TYPES="EMAIL_ADDRESS,PHONE_NUMBER,US_SOCIAL_SECURITY_NUMBER,CREDIT_CARD_NUMBER,IP_ADDRESS,STREET_ADDRESS,DATE_OF_BIRTH"
# Local Compose only: impersonated ADC file mounted read-only into Governance.
export GOOGLE_APPLICATION_CREDENTIALS_HOST=""
# Optional macOS Keychain source. Keychain cannot be mounted into Docker, so
# this writes a mode-0600 cache file and exports that path for Compose/ADC.
# export GOOGLE_APPLICATION_CREDENTIALS_HOST="$(scripts/google_adc_keychain.py materialize --expected-service-account "$GOOGLE_DLP_EXPECTED_SERVICE_ACCOUNT")"
# export GOOGLE_APPLICATION_CREDENTIALS="$GOOGLE_APPLICATION_CREDENTIALS_HOST"
# Add docker-compose.google-dlp.yml only when using local ADC in Compose.
# export COMPOSE_FILE="docker-compose.yml:docker-compose.google-dlp.yml"
# The Google override runs a credential sentinel every 30 seconds. Governance
# treats a missing, failed, or older-than-90-second signal as unavailable.
# export GOOGLE_ADC_PROBE_INTERVAL_SECONDS="30"
# export GOOGLE_ADC_STATUS_MAX_AGE_SECONDS="90"
# export GOOGLE_ADC_RETRY_AFTER_SECONDS="60"

# --- Vertex AI Gemini adapter (SA-authenticated path) ---
# Distinct prefix from GOOGLE_DLP_* on purpose: this configures the
# proxy service's Vertex AI access, independently of governance's DLP
# credential-sentinel setup, even when pointed at the same GCP project.
export GEMINI_VERTEX_PROJECT_ID=""
export GEMINI_VERTEX_LOCATION="us-central1"   # or "global"
export GEMINI_VERTEX_CREDENTIALS_PATH=""       # optional; ADC auto-discovery if unset
export GEMINI_VERTEX_EXPECTED_SERVICE_ACCOUNT=""
export GEMINI_VERTEX_TIMEOUT_SECONDS="60"

# Mock providers let demos/tests run without real upstream LLM API keys.
export MOCK_PROVIDERS="true"

# Optional local provider.
export OLLAMA_BASE_URL="http://localhost:11434/v1"
