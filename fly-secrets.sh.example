#!/usr/bin/env bash
# Run once per app after `fly apps create`.
#
# This example intentionally reads values from your shell environment instead of
# embedding placeholders that look like credentials. Export the variables below
# locally, then run this script. Never commit actual secrets.

set -euo pipefail

: "${JWT_SECRET:?set JWT_SECRET to a strong random value}"
: "${GOVERNANCE_INTERNAL_TOKEN:?set GOVERNANCE_INTERNAL_TOKEN to a strong random value}"
: "${GATEWAY_BOOTSTRAP_TOKEN:?set GATEWAY_BOOTSTRAP_TOKEN to a strong random value}"
: "${PSEUDONYM_HMAC_KEY:?set PSEUDONYM_HMAC_KEY to a strong random value}"
: "${DATABASE_URL:?set DATABASE_URL to the private Postgres URL}"
: "${REDIS_URL:?set REDIS_URL to the private Redis URL}"
: "${OPENAI_API_KEY:?set OPENAI_API_KEY or remove it from the command below}"
: "${ANTHROPIC_API_KEY:?set ANTHROPIC_API_KEY or remove it from the command below}"
: "${GEMINI_API_KEY:?set GEMINI_API_KEY or remove it from the command below}"

# Proxy — public-facing app
# Note: PSEUDONYM_HMAC_KEY is NOT set here — it belongs only to governance and cron.
fly secrets set -a ai-gateway-proxy \
  JWT_SECRET="$JWT_SECRET" \
  GOVERNANCE_INTERNAL_TOKEN="$GOVERNANCE_INTERNAL_TOKEN" \
  GATEWAY_BOOTSTRAP_TOKEN="$GATEWAY_BOOTSTRAP_TOKEN" \
  REDIS_URL="$REDIS_URL" \
  OPENAI_API_KEY="$OPENAI_API_KEY" \
  ANTHROPIC_API_KEY="$ANTHROPIC_API_KEY" \
  GEMINI_API_KEY="$GEMINI_API_KEY" \
  DATABASE_URL="$DATABASE_URL"

# Governance — internal only
fly secrets set -a ai-gateway-governance \
  GOVERNANCE_INTERNAL_TOKEN="$GOVERNANCE_INTERNAL_TOKEN" \
  PSEUDONYM_HMAC_KEY="$PSEUDONYM_HMAC_KEY" \
  DATABASE_URL="$DATABASE_URL"

# OPA — internal only, no secrets needed beyond what's baked into policy bundles
# fly secrets set -a ai-gateway-opa ...

# Cron — nightly partition rotation (02:00 UTC)
fly secrets set -a ai-gateway-cron \
  DATABASE_URL="$DATABASE_URL"
