#!/usr/bin/env bash
# Run once per app after `fly apps create`.
# Replace every REPLACE_ME_* value with a real secret before executing.
# Never commit actual secrets — use `fly secrets set` or the Fly dashboard.
#
# Pre-flight: abort if any placeholder is still present
if grep -q 'REPLACE_ME_' "$0"; then
  echo "ERROR: replace all REPLACE_ME_* values with real secrets before running" >&2
  exit 1
fi

set -euo pipefail

# Proxy — public-facing app
# Note: PSEUDONYM_HMAC_KEY is NOT set here — it belongs only to governance and cron.
fly secrets set -a ai-gateway-proxy \
  JWT_SECRET="replace-with-random-jwt-secret" \
  GOVERNANCE_INTERNAL_TOKEN="replace-with-random-internal-token" \
  GATEWAY_BOOTSTRAP_TOKEN="replace-with-random-bootstrap-token" \
  REDIS_URL="replace-with-private-redis-url" \
  OPENAI_API_KEY="replace-with-openai-provider-key" \
  ANTHROPIC_API_KEY="replace-with-anthropic-provider-key" \
  GEMINI_API_KEY="replace-with-gemini-provider-key" \
  DATABASE_URL="replace-with-private-database-url"

# Governance — internal only
fly secrets set -a ai-gateway-governance \
  GOVERNANCE_INTERNAL_TOKEN="REPLACE_ME_GOVERNANCE_INTERNAL_TOKEN" \
  PSEUDONYM_HMAC_KEY="REPLACE_ME_PSEUDONYM_HMAC_KEY_MIN_32_CHARS" \
  DATABASE_URL="REPLACE_ME_DATABASE_URL"

# OPA — internal only, no secrets needed beyond what's baked into policy bundles
# fly secrets set -a ai-gateway-opa ...

# Cron — nightly partition rotation (02:00 UTC)
fly secrets set -a ai-gateway-cron \
  DATABASE_URL="REPLACE_ME_DATABASE_URL"
