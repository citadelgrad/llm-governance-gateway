FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /app

COPY proxy/pyproject.toml proxy/uv.lock ./
RUN uv sync --frozen --no-dev

COPY proxy/ .
# config/ is baked into the image at build time for Fly.io deployments.
# Unlike docker-compose.yml which mounts it as a volume (hot-reloadable),
# changes to config/ on Fly.io require a full image rebuild and redeploy.
COPY config/ config/

CMD ["uv", "run", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
